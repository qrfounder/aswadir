# Local dev: copy this file to `.env` and paste your keys (gitignored).
# Easypanel: paste the same keys in Environment — no .env file needed there.
#
# Stripe keys (runtime — read by server.js /api/config and api/*)
# Get them from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# From Stripe → Webhooks → endpoint → Signing secret (after you add the URL)
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# Public site URL (used for Stripe Checkout success/cancel and billing portal return)
# Local dev with Vite: http://localhost:5173  |  single-port preview: http://localhost:3000
SITE_URL=http://localhost:5173

# Free trial before first charge (days)
STRIPE_TRIAL_DAYS=1

# REQUIRED: Stripe Price IDs — monthly recurring USD ($4.99 singles, $9.99 bundle)
# Create in Dashboard or run: npm run stripe:setup  (amounts in USD cents: 499 / 999)
STRIPE_PRICE_TASK=price_REPLACE_ME
STRIPE_PRICE_HABIT=price_REPLACE_ME
STRIPE_PRICE_BUNDLE=price_REPLACE_ME

# Use development locally so test-mode fallbacks work when keys are missing
NODE_ENV=development
HOST=0.0.0.0
# Easypanel usually sets PORT automatically — do not hardcode unless you know the service port

# SQLite — REQUIRED on Easypanel: mount a volume at /app/data and use this path
DATABASE_PATH=/app/data/massar.db
