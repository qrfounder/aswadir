# ─────────────────────────────────────────────────────────────────────────────
# Massar — copy to `.env` for local dev (gitignored). Easypanel: paste in Environment.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ TEST MODE (local dev — no real money) ═══
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# stripe listen --forward-to localhost:3000/api/stripe-webhook  → whsec_...
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ═══ LIVE MODE (production — real money) ═══
# 1. Complete Stripe account activation
# 2. Toggle Dashboard to LIVE: https://dashboard.stripe.com/apikeys
# 3. Replace ALL keys below with pk_live_ / sk_live_ (never mix test + live)
# STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME   # from LIVE webhook endpoint only

# Public site URL (Stripe success/cancel + billing portal return)
# Local Vite: http://localhost:5173  |  single-port: http://localhost:3000
# Production: https://aswadir.store
SITE_URL=http://localhost:5173

# Ignored — checkout never applies a Stripe trial (immediate payment required).
# STRIPE_TRIAL_DAYS=0

# Monthly recurring Price IDs (USD) — create via: npm run stripe:setup
# Must be created in the SAME mode as your secret key (test prices for sk_test_, live for sk_live_)
STRIPE_PRICE_TASK=price_REPLACE_ME
STRIPE_PRICE_HABIT=price_REPLACE_ME
STRIPE_PRICE_BUNDLE=price_REPLACE_ME

# TikTok Ads pixel (baked into build — set in Easypanel Docker build args too)
VITE_TIKTOK_PIXEL_ID=CU1EACBC77UAQJITPDR0

# Checkout shows card + Apple Pay only (Link disabled in code). In Stripe Dashboard →
# Settings → Payment methods, also disable Link and any wallets you do not want.

# development = allows dev checkout simulation when Stripe keys missing
# production = requires live keys + webhook; no simulated checkout
NODE_ENV=development
HOST=0.0.0.0

# SQLite — Easypanel: mount volume at /app/data
DATABASE_PATH=/app/data/massar.db

# Mojourney admin (/mojourney) — never commit real passwords
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_local_env_only
# Or use a bcrypt hash instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=
# Generate hash: node scripts/hash-admin-password.mjs 'your-password'

# Optional legacy build-time vars (frontend loads publishable key from /api/config at runtime)
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=
