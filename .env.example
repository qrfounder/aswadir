# Stripe keys (runtime — read by server.js /api/config and api/*)
# Get them from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# From Stripe → Webhooks → endpoint → Signing secret (after you add the URL)
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

NODE_ENV=production
HOST=0.0.0.0
# Easypanel usually sets PORT automatically — do not hardcode unless you know the service port

# SQLite — REQUIRED on Easypanel: mount a volume at /app/data and use this path
DATABASE_PATH=/app/data/massar.db

# External product delivery (Google Sheets "Make a copy" links — NOT hosted on this site)
# Upload deliverables/google-sheets/*.xlsx to Drive, then paste /copy URLs here.
VITE_DELIVERY_URL_HABIT=
VITE_DELIVERY_URL_TASK=
VITE_DELIVERY_URL_BUNDLE=
